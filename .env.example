# =============================================================================
# TRIPLEDGER — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and replace placeholder values before running.
# NEVER commit .env or real secrets to version control.
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
# Production requires https:// and non-localhost URL for email verification links
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB)
# If local MongoDB service is not running, the development server can optionally
# fall back to an embedded MongoDB instance when USE_IN_MEMORY_DB=true.
MONGODB_URI=mongodb://127.0.0.1:27017/tripledger
USE_IN_MEMORY_DB=false

# Authentication & JWT Secrets (Generate strong >=32-char / 64-byte hex secrets in production)
JWT_ACCESS_SECRET=replace_with_strong_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security & Rate Limiting
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
# Deployment rate-limit store: production defaults to "mongo" (shared multi-instance TTL buckets).
# Do not use "memory" in production unless DEPLOYMENT_TOPOLOGY=single-instance is explicitly set.
RATE_LIMIT_STORE=memory
DEPLOYMENT_TOPOLOGY=multi-instance
# Reverse proxy trust setting (e.g. "false", "1", "loopback"; never "true" in production)
TRUST_PROXY=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=15
AUTH_REGISTER_RATE_LIMIT_MAX=10
AUTH_VERIFY_EMAIL_RATE_LIMIT_MAX=20
AUTH_RESEND_VERIFICATION_RATE_LIMIT_MAX=5

# Email Verification Delivery Provider
# Allowed: DISABLED, MEMORY (non-production only), SMTP, WEBHOOK
# Production requires SMTP or WEBHOOK and fails startup if DISABLED or MEMORY.
EMAIL_PROVIDER=MEMORY
EMAIL_FROM=TripLedger <no-reply@tripledger.local>
EMAIL_DELIVERY_TIMEOUT_MS=10000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_API_KEY=

# Frontend Public Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=TripLedger
VITE_DEFAULT_CURRENCY=NPR
