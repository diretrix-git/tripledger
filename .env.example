# =============================================================================
# TRIPLEDGER — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and replace placeholder values before running.
# NEVER commit .env or real secrets to version control.
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB)
# If local MongoDB service is not running, the development server can optionally
# fall back to an embedded MongoDB instance when USE_IN_MEMORY_DB=true.
MONGODB_URI=mongodb://127.0.0.1:27017/tripledger
USE_IN_MEMORY_DB=false

# Authentication & JWT Secrets (Generate strong 64-byte hex secrets in production)
JWT_ACCESS_SECRET=replace_with_strong_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security & Rate Limiting
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Frontend Public Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=TripLedger
VITE_DEFAULT_CURRENCY=NPR
